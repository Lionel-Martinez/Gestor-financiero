APP_NAME="Gestor Financiero API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MySQL 8.4 LTS, InnoDB, utf8mb4. En producción usar dos usuarios (ver docs/04-seguridad-y-despliegue).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestor_financiero
DB_USERNAME=gf_migrator
DB_PASSWORD=change-me

# API pura: sin sesiones web
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

SANCTUM_STATEFUL_DOMAINS=
